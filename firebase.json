{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      ".firebaserc",
      ".git",
      ".git/**",
      ".claude",
      ".claude/**",
      ".github",
      ".github/**",
      ".firebase",
      ".firebase/**",
      ".gitignore",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
